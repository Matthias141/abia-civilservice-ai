# Anthropic API Key
# Get yours at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Server Settings
HOST=0.0.0.0
PORT=8000

# CORS — Frontend URL (change in production)
FRONTEND_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT=20/minute

# Set a strong, backend-only token to enable document uploads and re-indexing.
ADMIN_TOKEN=

# Model Selection
CLAUDE_MODEL=claude-sonnet-4-20250514
MAX_TOKENS=1500
